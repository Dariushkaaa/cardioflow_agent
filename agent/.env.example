# Если LLM_API_KEY пустой, агент работает в режиме правил (regex-разбор реплик) - без внешних вызовов.
# GigaChat: укажите "Ключ авторизации" из личного кабинета GigaChat API (агент сам получает OAuth-токен).
LLM_API_KEY=
LLM_MODEL_NAME=GigaChat
LLM_BASE_URL=https://api.giga.chat/v1
LLM_PROVIDER=auto
LLM_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
LLM_SCOPE=GIGACHAT_API_PERS
LLM_VERIFY_SSL=false
LLM_CA_BUNDLE=
LLM_TIMEOUT=30
BACKEND_API_URL=http://localhost:8000/api/v1
REQUEST_TIMEOUT=15
TIMEZONE=Europe/Moscow
