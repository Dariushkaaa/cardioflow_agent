# Все значения необязательны: без .env система стартует с настройками по умолчанию.
# Скопируйте в .env, если нужно что-то поменять:  cp .env.example .env

# Порты на хосте
FRONTEND_PORT=3000
BACKEND_PORT=8000
AGENT_PORT=8001
DB_PORT=5433

# Секрет для подписи JWT (в продакшене обязательно замените)
SECRET_KEY=cardioflow-dev-secret-change-me-in-production

# Часовой пояс пациентов (расписание приема, окно тишины, показ времени слотов)
TIMEZONE=Europe/Moscow

# LLM для агента: GigaChat (Сбер). Если LLM_API_KEY пустой, агент разбирает реплики по правилам
# и работает без интернета (сценарии диалога при этом работают так же).
#
# LLM_API_KEY - "Ключ авторизации" проекта GigaChat API из личного кабинета (base64 от client_id:client_secret).
# Агент сам обменивает его на access token (OAuth, живет ~30 минут) и обновляет токен автоматически.
# Не коммитьте настоящий ключ: .env уже в .gitignore.
LLM_API_KEY=
LLM_MODEL_NAME=GigaChat
LLM_BASE_URL=https://api.giga.chat/v1

# Необязательные настройки GigaChat
# auto | gigachat | openai (auto: GigaChat, если в адресе или модели есть giga/sber)
LLM_PROVIDER=auto
LLM_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_API_PERS (физлица), GIGACHAT_API_B2B или GIGACHAT_API_CORP
LLM_SCOPE=GIGACHAT_API_PERS
# Сертификаты Сбера подписаны российским УЦ Минцифры. false = не проверять сертификат (работает сразу, но менее безопасно).
# Для строгой проверки смонтируйте корневой сертификат в контейнер agent и укажите путь в LLM_CA_BUNDLE.
LLM_VERIFY_SSL=false
LLM_CA_BUNDLE=
